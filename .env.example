# Copy to .env and adjust. Never commit .env.
# Any value here overrides config/*.yaml.

# Which config/<name>.yaml overlay to apply
NWIS_ENV=development

# Database. The compose stack provides Postgres + PostGIS + TimescaleDB + pgvector.
DATABASE_URL=postgresql+psycopg://nwis:change-me@localhost:5432/nwis
POSTGRES_USER=nwis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nwis

# API
API_PORT=8000
LOG_LEVEL=INFO

# Frontend (read by Vite at build time)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Arbitrary config overrides use the NWIS__SECTION__KEY convention, e.g.
# NWIS__ANALOGUE__TOP_K=8
# NWIS__ALERTS__COOLDOWN_SECONDS=600
